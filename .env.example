# Copy this file to .env and fill in the real values. Never commit .env.

# From @BotFather on Telegram: /newbot, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# From https://datamall.lta.gov.sg -> Register -> check email for the
# AccountKey (see README.md "Getting API access" for the full walkthrough).
LTA_ACCOUNT_KEY=

# --- Optional tuning (sensible defaults if you leave these unset) ---

# How many carparks /nearest returns.
NEAREST_RESULT_COUNT=5

# /nearest won't return anything farther than this (km).
NEAREST_MAX_RADIUS_KM=3.0

# How long the static HDB carpark dataset (shelter/free-paid info) is
# cached before re-fetching from data.gov.sg, in seconds. It barely
# changes, so the default is 24h.
STATIC_DATA_TTL_SECONDS=86400

# How long a live LTA lot-availability poll is cached before the next
# command triggers a re-fetch, in seconds. LTA refreshes ~once a minute.
LIVE_DATA_TTL_SECONDS=45
